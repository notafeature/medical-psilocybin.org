// The hub at medical-psilocybin.org: static assets served by a Cloudflare Worker
// with no code of its own. Its own project, its own name, its own repository,
// so it can never collide with the counter Worker (nmmpab-count) that the rules
// repository deploys; see OPERATIONS.md there, Part 5.
//
// Deploy: npx wrangler@4 deploy --config ./wrangler.jsonc
// The DNS records the routes ride on already exist in the zone.
{
  "name": "medical-psilocybin-hub",
  "compatibility_date": "2026-07-01",
  // The personal Cloudflare account, the same one that holds the zone.
  "account_id": "2418db2ff3f95726c374a86551d2436e",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Zone routes over the zone's proxied placeholder records for the apex and www
  // (A records to 192.0.2.0): the Worker answers every request on either host and
  // the placeholder origin is never contacted. Custom domains would need those
  // records deleted first, which the deploy credentials cannot do.
  "routes": [
    { "pattern": "medical-psilocybin.org/*", "zone_name": "medical-psilocybin.org" },
    { "pattern": "www.medical-psilocybin.org/*", "zone_name": "medical-psilocybin.org" }
  ]
}
